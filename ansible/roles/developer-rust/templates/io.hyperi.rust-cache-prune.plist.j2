{% set weekday_num = {'Sun': 0, 'Mon': 1, 'Tue': 2, 'Wed': 3, 'Thu': 4, 'Fri': 5, 'Sat': 6}.get(rust_cache_prune_schedule_weekday) %}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ rust_cache_prune_label }}</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/hyperi-rust-cache-prune</string>
        <string>--yes</string>
        <string>--max-size</string>
        <string>{{ rust_cache_build_dir_max }}</string>
        <string>--max-age-days</string>
        <string>{{ rust_cache_max_age_days }}</string>
{% if rust_cache_root %}
        <string>--cache-root</string>
        <string>{{ rust_cache_root }}</string>
{% endif %}
    </array>

    <!-- A launchd agent inherits no shell profile, and the pruner reads
         CARGO_HOME to find the config that names the pool. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CARGO_HOME</key>
        <string>{{ developer_rust_cargo_home }}</string>
    </dict>

    <!-- launchd runs a missed calendar job once the machine wakes, which is
         what a laptop closed overnight needs. Omitting Weekday means daily. -->
    <key>StartCalendarInterval</key>
    <dict>
{% if weekday_num is not none %}
        <key>Weekday</key>
        <integer>{{ weekday_num }}</integer>
{% endif %}
        <key>Hour</key>
        <integer>{{ rust_cache_prune_schedule_hour | int }}</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Walking a large pool is IO-bound; it must never compete with a build. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>19</integer>

    <key>StandardOutPath</key>
    <string>{{ user_home }}/Library/Logs/hyperi-rust-cache-prune.log</string>
    <key>StandardErrorPath</key>
    <string>{{ user_home }}/Library/Logs/hyperi-rust-cache-prune.log</string>
</dict>
</plist>
