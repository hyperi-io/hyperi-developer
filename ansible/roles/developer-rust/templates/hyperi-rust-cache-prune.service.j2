[Unit]
Description=Bound the pooled Rust build cache

[Service]
Type=oneshot
User={{ actual_user }}
# A systemd unit inherits none of the user's shell environment, and the pruner
# reads $CARGO_HOME to find the config that names the pool. Without this it
# falls back to ~/.cargo and prunes against the wrong config on exactly the
# hosts that relocate the toolchain.
Environment="CARGO_HOME={{ developer_rust_cargo_home }}"
# Runs entirely inside the user's own cache directory, so it needs no sudo.
ExecStart=/usr/local/bin/hyperi-rust-cache-prune --yes --max-size {{ rust_cache_build_dir_max }} --max-age-days {{ rust_cache_max_age_days }}{{ ' --cache-root ' ~ rust_cache_root if rust_cache_root else '' }}
# Walking a large pool is IO-bound; it must never compete with an active build.
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=1800
