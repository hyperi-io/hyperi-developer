# Install
# ---------------------------------------------------------------------------


def _sccache_target() -> str | None:
    """The upstream target triple for this machine, or None if unpublished.

    musl for both: the binary is then independent of the host glibc, which is
    what lets one artefact serve every distro the role supports.
    """
    return {
        "x86_64": "x86_64-unknown-linux-musl",
        "aarch64": "aarch64-unknown-linux-musl",
    }.get(platform.machine())


def _installed_sccache_version() -> str | None:
    """The version of the sccache this script manages, or None if absent."""
    if not SCCACHE_BIN.is_file():
        return None
    proc = run([str(SCCACHE_BIN), "--version"], timeout=60)
    if proc.returncode != 0:
        return None
    match = re.search(r"(\d+\.\d+\.\d+)", proc.stdout)
    return match.group(1) if match else None


def install_sccache_linux(dry_run: bool, rep: Reporter) -> None:
    """Put the latest upstream sccache release at SCCACHE_BIN.

    Re-runs are a no-op once the installed version matches the latest tag, so
    the same call both installs and upgrades and hyperi-update needs no special
    case.
    """
    target = _sccache_target()
    if target is None:
        rep.warn(f"sccache: no upstream build for {platform.machine()} -- skipping")
        return

    url = f"https://api.github.com/repos/{SCCACHE_REPO}/releases/latest"
    try:
        with urllib.request.urlopen(url, timeout=60) as response:
            latest = json.load(response)["tag_name"]
    except (OSError, ValueError, KeyError) as exc:
        rep.warn(f"sccache: could not read the latest release ({exc}) -- leaving it alone")
        return

    current = _installed_sccache_version()
    if current and latest.lstrip("v") == current:
        rep.info(f"sccache {current} is current")
        return

    if dry_run:
        rep.info(f"[check] would install sccache {latest} (have {current or 'none'})")
        return

    asset = f"sccache-{latest}-{target}.tar.gz"
    base = f"https://github.com/{SCCACHE_REPO}/releases/download/{latest}"
    with tempfile.TemporaryDirectory() as tmp:
        tarball = Path(tmp) / asset
        try:
            urllib.request.urlretrieve(f"{base}/{asset}", tarball)
            with urllib.request.urlopen(f"{base}/{asset}.sha256", timeout=60) as response:
                expected = response.read().decode().split()[0]
        except (OSError, IndexError) as exc:
            rep.warn(f"sccache: download failed ({exc}) -- leaving it alone")
            return

        actual = hashlib.sha256(tarball.read_bytes()).hexdigest()
        if actual != expected:
            # A tag can be force-moved and a release asset re-uploaded under it,
            # so the digest is the only thing here that cannot be changed after
            # the fact. Refuse rather than wire an unverified binary into every
            # compile on the box.
            rep.warn(f"sccache: digest mismatch for {asset} -- refusing to install")
            return

        shutil.unpack_archive(str(tarball), tmp)
        extracted = Path(tmp) / f"sccache-{latest}-{target}" / "sccache"
        if not extracted.is_file():
            rep.warn(f"sccache: {asset} did not contain the expected binary -- skipping")
            return

        proc = run(["sudo", "install", "-m", "0755", str(extracted), str(SCCACHE_BIN)], timeout=120)

    if proc.returncode != 0:
        rep.warn(f"sccache: install to {SCCACHE_BIN} failed -- {proc.stderr.strip()}")
        return
    rep.change(f"installed sccache {latest} to {SCCACHE_BIN}")


def remove_distro_sccache(family: str, dry_run: bool, rep: Reporter) -> None:
    """Drop a distro sccache so only the managed copy answers on PATH.

    Two packaged copies at different versions is the shadowing problem this
    change exists to end, just moved from ~/.cargo/bin to /usr/bin.
    """
    if family == "debian":
        check = ["dpkg-query", "-W", "-f=${Status}", "sccache"]
        remove = ["sudo", "apt-get", "remove", "-y", "sccache"]
    elif family == "fedora":
        check = ["rpm", "-q", "sccache"]
        remove = ["sudo", "dnf", "remove", "-y", "sccache"]
    else:
        return

    proc = run(check, timeout=60)
    if proc.returncode != 0 or "installed" not in proc.stdout:
        return
    if dry_run:
        rep.info("[check] would remove the distro sccache, superseded by the release build")
        return
    if run(remove, timeout=300).returncode == 0:
        rep.change("removed the distro sccache, superseded by the release build")


def install_packages(family: str, dry_run: bool, rep: Reporter) -> None:
    """Install from the system package manager -- the top of the packaging ladder.

    Repo packages are signed and update with the rest of the system, which is
    why mold and clang come from here. sccache does not: see SCCACHE_REPO.
    """
    packages = MACOS_PACKAGES if family == "macos" else LINUX_PACKAGES
    # packaged_tool, not which: a cargo-installed shadow must not make us think
    # the packaged copy is already there, or we would defer to the stale binary
    # forever and never install the one that actually gets updates.
    missing = [p for p in packages if packaged_tool(p) is None]

    if not missing:
        rep.info(f"already present: {', '.join(packages)}")
        return

    if dry_run:
        rep.info(f"[check] would install: {', '.join(missing)}")
        return

    if family == "debian":
        cmd = ["sudo", "apt-get", "install", "-y", *missing]
    elif family == "fedora":
        cmd = ["sudo", "dnf", "install", "-y", *missing]
    elif family == "macos":
        cmd = ["brew", "install", *missing]
    else:
        rep.warn(f"no package manager for platform '{family}'")
        return

    rep.info(f"installing: {', '.join(missing)}")
    try:
        proc = run(cmd, timeout=900)
    except subprocess.TimeoutExpired:
        rep.warn(f"install timed out: {' '.join(missing)}")
        return

    if proc.returncode != 0:
        # Warn, do not die: a missing accelerator must not fail provisioning.
        # write_cargo_config() will simply leave out whatever did not land.
        rep.warn(f"install failed for {', '.join(missing)}: {proc.stderr.strip()}")
        return

    rep.change(f"installed {', '.join(missing)}")


def install_cargo_sweep(dry_run: bool, rep: Reporter) -> None:
    """cargo-sweep clears out stale build artefacts. Not packaged anywhere, so
    it comes from cargo -- but it is a plain tool, not wired into every build,
    so the blast radius is a failed install rather than a broken toolchain.
    """
    if shutil.which("cargo-sweep") is not None:
        rep.info("already present: cargo-sweep")
        return
    if shutil.which("cargo") is None:
        rep.warn("cargo not found -- skipping cargo-sweep")
        return
    if dry_run:
        rep.info("[check] would install cargo-sweep")
        return

    # cargo-binstall fetches a prebuilt binary; cargo install compiles it.
    if shutil.which("cargo-binstall") is not None:
        cmd = ["cargo", "binstall", "--no-confirm", "cargo-sweep"]
    else:
        cmd = ["cargo", "install", "cargo-sweep", "--locked"]

    rep.info(f"installing cargo-sweep ({cmd[1]})")
    try:
        proc = run(cmd, timeout=900)
    except subprocess.TimeoutExpired:
        rep.warn("cargo-sweep install timed out")
        return
    if proc.returncode != 0:
        rep.warn(f"cargo-sweep install failed: {proc.stderr.strip()}")
        return
    rep.change("installed cargo-sweep")


