MANAGED_HEADER = "# MANAGED BY hyperi-rust-setup"
MANAGED_ENV_BEGIN = "# BEGIN hyperi-rust-setup cache caps"
MANAGED_ENV_END = "# END hyperi-rust-setup cache caps"
CARRIED_MARKER = "# --- carried over from the previous config; not managed here ---"

# Emitted at the top of every generated config, and stripped again on the way
# back in so a re-run cannot carry the previous run's banner into the new file.
MANAGED_PREAMBLE = (
    MANAGED_HEADER,
    "# Re-run hyperi-rust-setup to update it.",
    "#",
    "# Edits here are overwritten. Per-project .cargo/config.toml wins over",
    "# this file, so override there.",
)
GENERATED_LINES = frozenset({*MANAGED_PREAMBLE, CARRIED_MARKER})

# Anything we put in the config must be proven present first -- naming a tool
# that is not installed breaks every cargo command on the box, which is worse
# than not configuring it at all.
LINUX_PACKAGES = ("mold", "clang")
MACOS_PACKAGES = ("sccache",)  # mold is ELF-only; it cannot link Mach-O.

# sccache is NOT in LINUX_PACKAGES: Ubuntu ships 0.13.0 against an upstream on
# 0.17.x, and a wrapper four versions behind is what a developer hits when a
# hand-run `sccache --show-stats` fails against the server their build started.
# It comes from the project's own release instead, latest on every run, with the
# digest checked against the .sha256 upstream publishes beside every asset.
# crates.io stays out of the global rustc-wrapper path, which is the objection
# that put this on the distro in the first place.
#
# macOS keeps brew, which already tracks upstream.
SCCACHE_REPO = "mozilla/sccache"
SCCACHE_BIN = Path("/usr/local/bin/sccache")

# The only tables this script owns; every other table in an existing
# config.toml is carried across verbatim by split_toml_sections().
MANAGED_TABLES = frozenset({"build", "target"})

# build.build-dir is stable from Rust 1.91; older cargo ignores the key.
BUILD_DIR_MIN_CARGO = (1, 91)

# Sized for the smallest machine the role runs on, which is a laptop.
# Build boxes raise them through the Ansible vars.
DEFAULT_SCCACHE_MAX = "20G"
DEFAULT_CCACHE_MAX = "10G"
DEFAULT_BUILD_DIR_MAX = "40G"
DEFAULT_MAX_AGE_DAYS = 14

# profile.d reaches login shells and systemd --user units alike.
# macOS has no profile.d and gets a managed block in the shell rc instead.
LINUX_ENV_FILE = Path("/etc/profile.d/hyperi-rust-cache.sh")


class Reporter:
    """Collects what happened so the run can end with an honest summary."""

    def __init__(self) -> None:
        self.changed = False
        self.warnings: list[str] = []

    def info(self, msg: str) -> None:
        print(f"  {msg}")

    def step(self, msg: str) -> None:
        print(f"\n== {msg}")

    def change(self, msg: str) -> None:
        self.changed = True
        print(f"  CHANGED: {msg}")

    def warn(self, msg: str) -> None:
        self.warnings.append(msg)
        print(f"  WARNING: {msg}")


def run(
    cmd: list[str], *, check: bool = False, timeout: int = 600
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        check=check,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=timeout,
    )


def detect_platform() -> str:
    """Return 'macos', or the Linux distro family we know how to install on."""
    if sys.platform == "darwin":
        return "macos"
    if sys.platform != "linux":
        return "unsupported"

    os_release = Path("/etc/os-release")
    if not os_release.is_file():
        return "unsupported"

    fields: dict[str, str] = {}
    for line in os_release.read_text(encoding="utf-8").splitlines():
        key, _, value = line.partition("=")
        fields[key] = value.strip('"')

    ids = {fields.get("ID", "")} | set(fields.get("ID_LIKE", "").split())
    if ids & {"fedora", "rhel", "centos"}:
        return "fedora"
    if ids & {"debian", "ubuntu"}:
        return "debian"
    return "unsupported"


def cargo_home() -> Path:
    """Cargo reads $CARGO_HOME/config.toml, which is NOT always ~/.cargo.

    Getting this wrong writes a file cargo silently ignores.
    """
    env = os.environ.get("CARGO_HOME")
    return Path(env) if env else Path.home() / ".cargo"


def _cargo_bin_dirs() -> tuple[Path, ...]:
    return (cargo_home() / "bin", Path.home() / ".cargo" / "bin")


def _on_path(name: str) -> list[Path]:
    candidates = [Path(d) / name for d in os.environ.get("PATH", "").split(os.pathsep) if d]
    return [p for p in candidates if p.is_file() and os.access(p, os.X_OK)]


def packaged_tool(name: str) -> str | None:
    """Find a tool EXCLUDING cargo-installed copies.

    Kept separate from resolve_tool so that "is it installed?" cannot be
    answered "yes" by a leftover cargo binary -- otherwise we would skip
    installing the packaged copy and keep deferring to the stale one forever.
    """
    cargo_dirs = _cargo_bin_dirs()
    managed = [p for p in _on_path(name) if p.parent not in cargo_dirs]
    return str(managed[0]) if managed else None


def resolve_tool(name: str, rep: Reporter | None = None) -> str | None:
    """Find a tool, preferring a package-managed copy over a cargo-installed one.

    A leftover `cargo install`ed binary in ~/.cargo/bin usually sits ahead of
    /usr/bin on PATH, so plain `which` hands back the copy nobody updates --
    and we would then pin that path into every build on the box as the
    rustc-wrapper. Prefer the managed one, and say so when we step over a
    shadow, because the shadow still wins for anything the user types.
    """
    found = _on_path(name)
    if not found:
        return None

    cargo_dirs = _cargo_bin_dirs()
    managed = [p for p in found if p.parent not in cargo_dirs]
    shadowed = [p for p in found if p.parent in cargo_dirs]

    if managed:
        if shadowed and rep is not None:
            rep.warn(
                f"{name}: builds use {managed[0]}, but {shadowed[0]} shadows it on "
                f"PATH, so anything you run by hand talks to the wrong one. "
                f"Remove it with: cargo uninstall {name}"
            )
        return str(managed[0])

    if rep is not None:
        # Do not claim the distro has no package -- we only know none is on PATH
        # right now. Under --check that is simply "we have not installed it yet".
        rep.warn(
            f"{name}: using the cargo-installed {found[0]} -- no packaged copy on "
            f"PATH. Cargo-installed binaries do not auto-update."
        )
    return str(found[0])


def target_triple() -> str | None:
    """Ask rustc what it actually targets rather than guessing from uname."""
    if shutil.which("rustc") is None:
        return None
    proc = run(["rustc", "-vV"])
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        if line.startswith("host:"):
            return line.split(":", 1)[1].strip()
    return None


def cargo_version() -> tuple[int, int] | None:
    """Return cargo's (major, minor), used to gate keys that are not always stable."""
    if shutil.which("cargo") is None:
        return None
    proc = run(["cargo", "--version"], timeout=60)
    if proc.returncode != 0:
        return None
    match = re.search(r"\bcargo\s+(\d+)\.(\d+)", proc.stdout)
    return (int(match.group(1)), int(match.group(2))) if match else None


def cache_root(family: str) -> Path:
    """The platform's cache directory -- the one place a user expects to be evictable."""
    if family == "macos":
        return Path.home() / "Library" / "Caches"
    xdg = os.environ.get("XDG_CACHE_HOME")
    return Path(xdg) if xdg else Path.home() / ".cache"


def build_dir_path(family: str) -> Path:
    """Where intermediate build artefacts are pooled, and what the prune tool bounds."""
    return cache_root(family) / "hyperi-rust-build"


def shell_env_file(family: str) -> Path:
    """The file the cache caps are exported from.

    zsh reads .zshrc only for interactive shells, so a build launched from a
    script would not see a cap set there; .zshenv is read for every shell.
    """
    if family == "macos":
        return Path.home() / ".zshenv"
    return LINUX_ENV_FILE


