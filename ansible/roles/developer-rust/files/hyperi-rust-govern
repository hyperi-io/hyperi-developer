#!/usr/bin/env bash
# Governs Rust builds so they cannot take the machine down: every build runs at
# nice 19, and on Linux with a live user manager inside rustbuild.slice, whose
# memory budget and CPU weight the developer-rust role deploys. No core is
# withheld and no job count is set -- docs/rust-build-governor.md has the model.
#
# Installed as ~/.local/bin/cargo, ahead of the cargo bin directory on the SOE
# PATH, so cargo and everything it spawns is captured. sccache-hosted compiles
# are captured by hyperi-sccache.service's own Slice= and Nice=.
#
#   HYPERI_RUST_GOVERNOR=off cargo build     # bypass one invocation
#   hyperi-rust-govern <command> [args...]   # govern any other command
#
# Written for bash 3.2: stock macOS runs this.
set -u

# HOME is unset in a system unit, in a container whose uid has no passwd entry,
# and under env -i. Unset, set -u aborts at the first $HOME below before any
# tool runs; empty degrades to an unreadable config path, which is the right
# failure.
HOME="${HOME-}"

# The same path the role writes, so a host that sets XDG_CONFIG_HOME still
# reads the deployed file.
CONF="$HOME/.config/hyperi/rust-governor.conf"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

TOOL="$(basename "$0")"
if [ "$TOOL" = "hyperi-rust-govern" ]; then
    if [ "$#" -eq 0 ]; then
        echo "usage: hyperi-rust-govern <command> [args...]" >&2
        exit 64
    fi
    TOOL="$1"
    shift
fi

# $CARGO_HOME/bin first: rustup's proxies live there, and PATH cannot be
# trusted while this shim is on it. -ef skips the shim itself by inode, so
# the search cannot loop back through the symlink.
resolve_real() {
    candidate="${CARGO_HOME:-$HOME/.cargo}/bin/$TOOL"
    if [ -x "$candidate" ] && ! [ "$candidate" -ef "$0" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    old_ifs="$IFS"
    IFS=:
    for dir in $PATH; do
        IFS="$old_ifs"
        [ -n "$dir" ] || continue
        candidate="$dir/$TOOL"
        [ -x "$candidate" ] || continue
        [ "$candidate" -ef "$0" ] && continue
        printf '%s\n' "$candidate"
        return 0
    done
    IFS="$old_ifs"
    return 1
}

REAL="$(resolve_real)"
if [ -z "$REAL" ]; then
    echo "hyperi-rust-govern: no real '$TOOL' found ($CONF governs a tool that is not installed)" >&2
    exit 127
fi

# Already inside a governed scope, or explicitly bypassed: straight through.
if [ "${HYPERI_RUST_GOVERNOR:-on}" = "off" ] || [ -n "${HYPERI_RUST_GOVERNED:-}" ]; then
    exec "$REAL" "$@"
fi

export HYPERI_RUST_GOVERNED=1

# sccache cannot cache a rustc call carrying -C incremental. Off by default:
# cargo never builds dependencies incrementally, so this only makes WORKSPACE
# crates cacheable, and it costs incremental on those same crates. Worth it on a
# box where builds start from clean trees, not on an edit-rebuild loop.
#
# A caller's own value still wins, but setting it to 1 makes sccache refuse the
# build outright rather than fall back to compiling.
if [ "${HYPERI_RUST_GOVERN_NO_INCREMENTAL:-0}" = "1" ]; then
    export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
fi

# Linux with a live user manager: the scope joins rustbuild.slice, with nice
# inside it so the whole tree carries it. A bus socket left by a dead session
# or a container image is not a manager answering, so one round trip settles
# that before the exec.
if [ "$(uname -s)" = "Linux" ] && command -v systemd-run >/dev/null 2>&1 \
    && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ] \
    && systemctl --user show --property=Version >/dev/null 2>&1; then
    exec systemd-run --user --scope --quiet --collect \
        --slice=rustbuild.slice \
        -- nice -n 19 "$REAL" "$@"
fi

# Everywhere else -- macOS, a container, a degraded session: priority only, no
# memory bound.
exec nice -n 19 "$REAL" "$@"
