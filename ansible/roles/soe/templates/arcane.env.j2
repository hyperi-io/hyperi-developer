# Managed by hyperi-developer (ansible/roles/soe/tasks/arcane.yml).
# Edits are overwritten on the next SOE run -- change the soe_arcane_* vars.
#
# Secrets are generated once on this host and reused from here afterwards.
# Rotating ENCRYPTION_KEY orphans every credential Arcane has stored.
ENVIRONMENT=production
APP_URL=http://localhost:{{ soe_arcane_port }}
TZ={{ soe_arcane_timezone }}
ENCRYPTION_KEY={{ soe_arcane_encryption_key }}
JWT_SECRET={{ soe_arcane_jwt_secret }}
ADMIN_STATIC_API_KEY={{ soe_arcane_admin_api_key }}
{% if soe_arcane_long_session %}
# Only present when soe_arcane_long_session is on. Absent, the image's own 168h
# applies and every session dies at day seven.
JWT_REFRESH_EXPIRY={{ soe_arcane_refresh_expiry }}
{% endif %}
