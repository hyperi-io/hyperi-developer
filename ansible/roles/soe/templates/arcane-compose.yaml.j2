---
# Managed by hyperi-developer (ansible/roles/soe/tasks/arcane.yml).
# Edits are overwritten on the next SOE run -- change the soe_arcane_* vars.

services:
  arcane:
    image: ghcr.io/getarcaneapp/manager:{{ soe_arcane_ref }}
    container_name: arcane
    # Loopback on the host side only. Arcane holds the Docker socket, so
    # whatever reaches this port owns the machine. Under colima the VM's
    # forwarder still lands it on the Mac's own loopback, not the LAN.
    ports:
      - "127.0.0.1:{{ soe_arcane_port }}:3552"
    volumes:
      # Resolved by the daemon, not the client: on macOS this is the socket
      # inside colima's VM, which is the daemon Arcane has to manage.
      - /var/run/docker.sock:/var/run/docker.sock
      - arcane-data:/app/data
    env_file:
      - arcane.env
    # Lets Arcane identify its own container, which its self-updater needs.
    cgroup: host
    healthcheck:
      test: ["CMD", "./arcane", "health", "--timeout", "2s"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 15s
    # Brings Arcane back with the daemon: dockerd at boot on Linux, the colima
    # launch agent at login on macOS.
    restart: unless-stopped

volumes:
  arcane-data:
    name: arcane-data
