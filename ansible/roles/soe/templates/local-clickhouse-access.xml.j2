<?xml version="1.0"?>
<!-- Managed by hyperi-developer (roles/soe/tasks/local_services.yml). -->
<!-- Dev credentials on a loopback-only daemon: the password is a formality, -->
<!-- not a secret, so it is templated in the clear rather than generated. -->
<clickhouse>
    <users>
        <default>
            <password>{{ soe_local_clickhouse_password }}</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>
