# Ghostty Configuration - Cross-Platform Base
# This is the main config that loads platform-specific files
# Documentation: https://ghostty.org/docs/config

# ============================================================
# Platform-Specific Includes (optional, no error if missing)
# ============================================================
config-file = ?platform-linux.conf
config-file = ?platform-macos.conf

# User overrides (create this file for personal customizations)
config-file = ?local.conf

# ============================================================
# Font Configuration
# ============================================================
# Font size (font-family set in platform configs with fallbacks)
font-size = 11
# Font features: +prefix required in Ghostty 1.2.0+
font-feature = +calt
font-feature = +liga
font-feature = +dlig

# ============================================================
# Theme - Auto-switches with system light/dark mode
# ============================================================
# Solarized: Ghostty's own bundled iTerm2 Solarized pair. These ship INSIDE
# Ghostty on every platform - macOS in Ghostty.app/Contents/Resources/ghostty/
# themes/, Linux in /usr/share/ghostty/themes/ (owned by the ghostty package
# itself, verified with dpkg -S). No OS package, no vendored files, nothing to
# install. The "iTerm2" in the name is just upstream's naming from the
# iterm2-color-schemes collection - iTerm2 is NOT required.
#
# Auto-switches light/dark with the OS desktop appearance.
#
# We do NOT vendor a canonical Schoonover palette any more, for two reasons:
#
#   1. Vendored theme files only resolve from the XDG dir. macOS reads its
#      CONFIG from ~/Library/Application Support/com.mitchellh.ghostty/ but
#      resolves a bare theme NAME only from ~/.config/ghostty/themes/ and the
#      app bundle. Themes deployed next to the macOS config were never found,
#      and Ghostty silently fell back to its default dark theme.
#   2. The canonical palette is actively worse. It sets ANSI 8 to #002b36 -
#      the exact dark background, so bright-black text was invisible - and
#      ANSI 7 to #eee8d5 against the #fdf6e3 light background. The iTerm2
#      variant lifts both off the background (#335e69 / #bbb5a2) and is
#      otherwise identical to canonical Solarized.
#
# TRADEOFF: upstream renamed "Builtin Solarized" out from under us once
# before. If the theme stops applying after a Ghostty upgrade, check
# `ghostty +list-themes` for the current name.
theme = light:iTerm2 Solarized Light,dark:iTerm2 Solarized Dark

# ============================================================
# Terminal Compatibility
# ============================================================
# Use xterm-256color for SSH compatibility (remote systems don't have ghostty terminfo)
term = xterm-256color

# ============================================================
# Window Configuration
# ============================================================
window-height = 35
window-width = 140
window-padding-x = 8
window-padding-y = 8
window-save-state = always

# ============================================================
# Visual Effects - all platforms
# ============================================================
# Subtle transparency + blur (defined here, after the platform includes above,
# so it applies on Linux and macOS alike). NOTE: blur needs a compositor that
# supports it; over RDP transparency can cause artifacts - set background-opacity
# = 1.0 in ~/.config/ghostty/local.conf if that bites you.
background-opacity = 0.95
background-blur-radius = 20

# ============================================================
# Scrollback
# ============================================================
# Infrastructure work needs extensive history
scrollback-limit = 100000

# ============================================================
# Cursor
# ============================================================
cursor-style = block
cursor-style-blink = false

# ============================================================
# Shell Integration
# ============================================================
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ============================================================
# Mouse Behavior
# ============================================================
mouse-hide-while-typing = true

# ============================================================
# Split Visual Feedback
# ============================================================
# Dimmed unfocused splits help identify active pane
unfocused-split-opacity = 0.85
